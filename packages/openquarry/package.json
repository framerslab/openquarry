{
  "name": "openquarry",
  "version": "0.3.0",
  "description": "The openquarry command: start a folder of notes or a course in the OpenQuarry format, add notes and lessons, and check every file. Also re-exports the @framers/openquarry validators and types.",
  "keywords": [
    "openquarry",
    "quarry",
    "markdown",
    "frontmatter",
    "knowledge-base",
    "notes",
    "course",
    "lesson",
    "scaffold",
    "validator",
    "cli"
  ],
  "license": "MIT",
  "author": "Framers Lab, Inc.",
  "homepage": "https://openquarry.dev/package/#start",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/framerslab/openquarry.git",
    "directory": "packages/openquarry"
  },
  "bugs": {
    "url": "https://github.com/framerslab/openquarry/issues"
  },
  "type": "module",
  "bin": {
    "openquarry": "bin/openquarry.mjs"
  },
  "main": "./index.cjs",
  "module": "./index.js",
  "types": "./index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./index.d.ts",
        "default": "./index.js"
      },
      "require": {
        "types": "./index.d.cts",
        "default": "./index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "bin",
    "src",
    "templates",
    "index.js",
    "index.cjs",
    "index.d.ts",
    "index.d.cts",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "prepack": "node scripts/bundle-templates.mjs"
  },
  "dependencies": {
    "@framers/openquarry": "^0.3.0",
    "yaml": "^2.8.1"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
