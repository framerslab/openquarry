{
  "name": "@framers/openquarry",
  "version": "0.1.0",
  "description": "The OpenQuarry format for Markdown knowledge bases: JSON Schemas for note frontmatter and folder manifests, TypeScript types, and a validator.",
  "keywords": [
    "openquarry",
    "quarry",
    "markdown",
    "frontmatter",
    "json-schema",
    "knowledge-base",
    "notes",
    "zettelkasten",
    "validator",
    "typescript"
  ],
  "license": "MIT",
  "author": "Framers Lab, Inc.",
  "homepage": "https://github.com/framerslab/openquarry#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/framerslab/openquarry.git"
  },
  "bugs": {
    "url": "https://github.com/framerslab/openquarry/issues"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./schema/*": "./schema/*",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "schema",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsup",
    "schemas": "node scripts/build-schemas.mjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.20.5",
    "js-yaml": "^4.3.2",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
