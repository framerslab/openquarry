# The schema files and the module generated from them are compared byte for byte (the SHA-256 values in
# schema/SOURCE.json, and src/schemas.ts against a fresh render), so they keep LF line endings on every checkout.
schema/** text eol=lf
src/schemas.ts text eol=lf
# The starters are copied by degit and compared with this checkout byte for byte in CI.
templates/** text eol=lf
# The command's files are published from a Linux runner; the bin's first line must end in LF.
packages/openquarry/** text eol=lf
